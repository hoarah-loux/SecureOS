# General
.DS_Store

# Build artifacts
/src/boot/build/
build/
*/build/

# Object files and intermediates
*.o
*.obj
*.elf
*.a

# ...except the vendored newlib, which is a committed build artifact rather
# than build output. See src/userland/newlib/README.md.
!src/userland/newlib/lib/*.a
*.so

# Disk images / ISOs
*.iso
*.img

# Editor/project files
.vscode/
.idea/
.claude/
skills-lock.json

# Temporary files
*~
.cache/
.tmp
serial.log
qemu.log

# Fetched on demand by "make doom-wad": the shareware WAD is freely
# redistributable but is not ours to commit. See src/boot/Makefile.
/assets/

# ...except the hand-written ring3 test sources, which live there. Their
# built .elf outputs stay ignored by the *.elf rule above.
!/assets/elf_tests/
!/assets/elf_tests/*.S
!/assets/elf_tests/*.ld
